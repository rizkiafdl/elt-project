# dbt build output — regenerated by every run, never committed.
# target/manifest.json is published as a GitHub Release asset by CI (§6.5),
# which is what the cluster consumes. It is an artifact, not source.
target/
dbt_packages/
logs/

# DuckDB scratch warehouse. The `dev` target that produced these was removed on
# 2026-09-10, so nothing writes them any more. The patterns stay: an old working
# copy can still hold one, and committing a warehouse file to a public repository
# would publish whatever it contains.
*.duckdb
*.duckdb.wal

# Local toolchain
.venv/
__pycache__/
*.pyc

# Never commit credentials or environment
.env

# dbt anonymous-usage id, generated per machine. Not project source.
.user.yml
